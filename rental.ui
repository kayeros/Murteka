   <property name="styleSheet">
    <string notr="true">/* --- ОБЩИЙ ФОН --- */
QWidget {
    background-color: #FDF7FA;
    color: #4A4A4A;
}

/* --- ИМЯ ПИТОМЦА --- */
QLabel#petLabel {
    font-size: 20px;
    font-weight: bold;
    color: #2E659C; 
}

/* --- ПОЛЯ ДАТ --- */
QDateEdit {
    background-color: #FFFFFF;
    border: 2px solid #A8DADC; /* Голубая рамка */
    border-radius: 6px;
    padding-left: 10px;
    font-size: 13px;
}
QDateEdit:focus {
    border: 2px solid #E76F51; /* Персиковая при клике */
}

/* --- СРОК --- */
QLabel#daysLabel {
    font-size: 13px;
    color: #E76F51;
    font-weight: bold;
}

/* --- ГАЛОЧКА --- */
QCheckBox {
    color: #2E659C; 
    font-size: 13px;
    spacing: 10px;
}

/* --- КНОПКА --- */
QPushButton#sendBtn {
    background-color: #2E659C;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border-radius: 8px;
    padding: 10px;
}
QPushButton#sendBtn:hover {
    background-color: #F4D8CC;
}
QPushButton#sendBtn:disabled {
    background-color: #B0BEC5;
}

/* --- ОШИБКИ --- */
QLabel#errorLabel {
    font-weight: bold;
    font-size: 12px;
    color: #F0745D;
}</string>
