        <string notr="true">/* --- ВКЛАДКИ --- */
QTabWidget::pane {
    border: 1px solid #F4D8CC;
    background-color: #FFFFFF;
    border-radius: 6px;
    top: -1px; 
}

QTabBar::tab {
    background-color: #F6E6DF;
    color: #555555;
    padding: 8px 25px; 
    border: 1px solid #F4D8CC;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    qproperty-documentMode: false; 
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2E659C;
    font-weight: bold;
    border-top: 3px solid #F0745D;
}

