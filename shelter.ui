   <property name="styleSheet">
    <string notr="true">/* --- ОБЩИЙ ФОН --- */
QWidget {
    background-color: #F7F9FC;

}
/* --- ВИЗИТКА ПРИЮТА --- */
QWidget#profileWidget {
    background-color: #FFFFFF;
    border: 1px solid #C4D1E1;
    border-radius: 6px;
}

/* --- ОШИБКИ --- */
QLabel#errorLabel {
    color: #F0745D;
    font-weight: bold;
}
/* --- ТАБЛИЦЫ --- */
QTableWidget {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #C4D1E1;
    border-radius: 6px;
    gridline-color: #F0F4F8;
    selection-background-color: #E8EEF5;
    selection-color: #2E659C;
    outline: none;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:alternate {
    background-color: #F7F9FC; 
}

QHeaderView::section {
    background-color: #F7F9FC;
    color: #2E659C;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #C4D1E1;
    border-right: 1px solid #F0F4F8;
}</string>
